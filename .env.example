# ==============================================================================
# ROCK DANISH BIKER STUFF — ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development, or configure these keys
# inside Vercel Project Settings -> Environment Variables for production.
# NEVER commit real secret keys or `.env.local` to GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE AUTHENTICATION (Web SDK Public Configuration)
# Where to get these:
# Firebase Console (https://console.firebase.google.com)
# -> Project Settings -> General -> Your Apps -> Web App -> SDK setup & config
# Enable Authentication -> Sign-in method -> Email/Password & Google
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & STORAGE (Public URL & Anon Key)
# Where to get these:
# Supabase Dashboard (https://supabase.com/dashboard)
# -> Project Settings -> API -> Project URL & Project API keys (`anon` `public`)
# IMPORTANT: Never place the `service_role` secret key in any VITE_ variable.
# Enable Authentication -> Third-Party Auth -> Firebase in Supabase Dashboard
# so PostgreSQL RLS policies verify Firebase ID tokens automatically.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
